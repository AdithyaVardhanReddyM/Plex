# Plex for Mac brain (apps/agent). Copy to .env and fill in; .env is git-ignored.

# Gemini through Vertex AI (Google Cloud), not AI Studio
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
# global for the worker, operator, compiler and embeddings (the Live model uses us-central1 on its own)
GOOGLE_CLOUD_LOCATION=global
# Service-account key, e.g. .secrets/<project>-<id>.json (relative to apps/agent, or absolute)
GOOGLE_APPLICATION_CREDENTIALS=

# Convex: the local deployment from `pnpm dev`, and the shared secret checked by convex/lib/agentAuth.ts
# (set the same value in Convex: pnpm --filter @plex/backend exec convex env set PLEX_AGENT_SECRET ...)
CONVEX_URL=http://127.0.0.1:3210
PLEX_AGENT_SECRET=

# Composio project for the Mac's connected apps (Gmail, Calendar, Drive, Docs, Sheets, Slack, Notion)
COMPOSIO_MAC_API_KEY=
# Composio user the scheduler polls Gmail as when no Mac is connected (the Mac's user_id from hello)
PLEX_COMPOSIO_USER=

# Only when the brain is hosted: the bearer token the Mac app must send
MAC_CLIENT_TOKEN=

# Optional overrides (defaults shown)
# PLEX_LIVE_MODEL=gemini-3.8-live
# PLEX_LIVE_LOCATION=us-central1
# PLEX_VOICE=Aoede
# PLEX_WORKER_MODEL=gemini-3.8-flash
# PLEX_WORKER_FALLBACKS=gemini-3.6-flash,gemini-2.5-flash
# PLEX_WORKER_THINKING=LOW
# PLEX_OPERATOR_MODEL=gemini-3.8-flash
# PLEX_OPERATOR_FALLBACK=gemini-3.6-flash
# PLEX_SCREEN_MODEL=gemini-3.8-flash
# PLEX_SCREEN_FALLBACK=gemini-3.5-flash-lite
# PLEX_COMPILE_MODEL=gemini-3.8-flash
# PLEX_REFLECT_MODEL=gemini-3.8-flash
# PLEX_EMBED_MODEL=gemini-embedding-001
# PLEX_BROWSER_PROFILE=~/Library/Application Support/Plex/browser
# PLEX_SCHEDULER=on
# How often Gmail is checked for email-triggered routines, in seconds (30 for a filmed demo)
# PLEX_MAIL_POLL_S=300
# MAC_DEBUG=1
