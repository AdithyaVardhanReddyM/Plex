/**
 * Clerk → Convex auth. Set CLERK_JWT_ISSUER_DOMAIN in the Convex deployment
 * (`npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your>.clerk.accounts.dev`)
 * after creating a "convex" JWT template in Clerk. Until then everyone is a
 * guest exploring the demo world.
 *
 * To enable: rename this file to auth.config.ts once the env var is set.
 */
const domain = process.env.CLERK_JWT_ISSUER_DOMAIN;

export default {
  providers: domain ? [{ domain, applicationID: "convex" }] : [],
};
