# Copy to .env and fill in from https://developer.paypal.com/dashboard/applications/sandbox
# Used by scripts/refresh-paypal-token.sh and by the app's server-side PayPal calls.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Optional: a sandbox personal account that receives the demo workers' payouts (set in Convex too)
PAYPAL_DEMO_PAYEE_EMAIL=

# Gemini for every agent (set in Convex with `npx convex env set`). Pick one:
# a) Google Cloud Vertex AI with a service account (role: Vertex AI User).
#    GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION work too.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# b) Vertex AI express mode key instead of a service account
GOOGLE_VERTEX_API_KEY=
# c) AI Studio key (used only when Vertex isn't set)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: default model for every agent
GEMINI_MODEL_QUALITY=gemini-3.8-flash
 