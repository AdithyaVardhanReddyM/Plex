# Copy to .env and fill in from https://developer.paypal.com/dashboard/applications/sandbox
# Used by scripts/refresh-paypal-token.sh and by the app's server-side PayPal calls.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Optional: a sandbox personal account that receives the demo workers' payouts (set in Convex too)
PAYPAL_DEMO_PAYEE_EMAIL=
